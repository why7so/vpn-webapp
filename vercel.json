{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sub/:token",
      "destination": "https://vpn-bot-production-555c.up.railway.app/sub/:token"
    }
  ]
}
